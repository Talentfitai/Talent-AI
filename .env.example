# Database (gunakan Neon atau Supabase - pastikan pooled connection)
DATABASE_URL="postgresql://user:password@host:6543/dbname?schema=public"

# NextAuth (generate dengan: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Di production (Vercel), NEXTAUTH_URL akan otomatis dari domain Vercel
# Tapi bisa di-override di dashboard Vercel jika perlu
